---
import "../styles/global.css";
import { site } from "../data/site.js";
import { withBase } from "../lib/utils.js";

const {
  title,
  description = site.tagline,
  pageTitle,
  pageIntro,
  pageMeta
} = Astro.props;

const documentTitle = title ? `${title} · ${site.name}` : site.name;
const path = Astro.url.pathname;
const isActive = (href) => (href === "/" ? path === "/" : path.startsWith(href));

const nav = [
  { href: "/blog/inferences/", label: "inferences" },
  { href: "/blog/downtime/", label: "downtime" },
  { href: "/media/resume.pdf", label: "cv" }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    {import.meta.env.PROD && (
      <script
        defer
        src="https://cloud.umami.is/script.js"
        data-website-id="a971ad06-2d27-4efc-a405-ef890e415772"
      ></script>
    )}
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;1,8..60,400&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        var stored = localStorage.getItem("theme");
        var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.setAttribute("data-theme", stored || (prefersDark ? "dark" : "light"));
      })();
    </script>
  </head>
  <body>
    <main class="shell">
      <header class="site-header">
        <a class="brand" href={withBase("/")} aria-label="Home">
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <rect x="0" y="0" width="3" height="3" opacity="1" />
            <rect x="4.33" y="0" width="3" height="3" opacity="0.35" />
            <rect x="8.67" y="0" width="3" height="3" opacity="0.15" />
            <rect x="13" y="0" width="3" height="3" opacity="0.1" />
            <rect x="0" y="4.33" width="3" height="3" opacity="0.55" />
            <rect x="4.33" y="4.33" width="3" height="3" opacity="1" />
            <rect x="8.67" y="4.33" width="3" height="3" opacity="0.3" />
            <rect x="13" y="4.33" width="3" height="3" opacity="0.1" />
            <rect x="0" y="8.67" width="3" height="3" opacity="0.2" />
            <rect x="4.33" y="8.67" width="3" height="3" opacity="0.6" />
            <rect x="8.67" y="8.67" width="3" height="3" opacity="1" />
            <rect x="13" y="8.67" width="3" height="3" opacity="0.25" />
            <rect x="0" y="13" width="3" height="3" opacity="0.1" />
            <rect x="4.33" y="13" width="3" height="3" opacity="0.2" />
            <rect x="8.67" y="13" width="3" height="3" opacity="0.5" />
            <rect x="13" y="13" width="3" height="3" opacity="1" />
          </svg>
          <span>aritra</span>
        </a>
        <nav class="nav" aria-label="Primary">
          {nav.map((item) => (
            <a href={withBase(item.href)} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>
          ))}
          <button id="theme-toggle" aria-label="Toggle theme" title="Toggle theme">
            <svg id="icon-sun" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
            </svg>
            <svg id="icon-moon" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>
        </nav>
      </header>

      {pageTitle && (
        <section class="page-head">
          <h1>{pageTitle}</h1>
          {pageIntro && <p class="muted">{pageIntro}</p>}
          {pageMeta && <span class="mono">{pageMeta}</span>}
        </section>
      )}

      <slot />

      <footer class="site-footer">
        {site.socials.map((item) => (
          <a href={item.href}>{item.label.toLowerCase()}</a>
        ))}
        <span style="margin-left:auto">© {new Date().getFullYear()}</span>
      </footer>
    </main>
  </body>
</html>

<script>
  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const root = document.documentElement;
    const next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
    root.setAttribute("data-theme", next);
    localStorage.setItem("theme", next);
  });
</script>
