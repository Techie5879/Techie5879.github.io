---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const withBase = (path) => `${base}${path}`;
---
<html>
  <head>
    <meta http-equiv="refresh" content={`0;url=${withBase("/blog/technical/")}`} />
  </head>
  <body>
    <p>Redirecting… <a href={withBase("/blog/technical/")}>Technical Blog</a></p>
  </body>
</html>
