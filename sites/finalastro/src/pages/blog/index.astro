---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

function fmtDate(d) {
  const dd = String(d.getDate()).padStart(2, '0');
  const mm = String(d.getMonth() + 1).padStart(2, '0');
  return `${dd}-${mm}-${d.getFullYear()}`;
}
---

<BaseLayout
  title="Technical Blog | Astro"
  pageTitle="Technical Blog"
  pageIntro="An Astro blog listing built from content collections."
>
  <section class="article-list">
    {posts.map((post) => (
      <article class="article-card">
        <h2><a href={`${base}/blog/${post.id}/`}>{post.data.title}</a></h2>
        <p class="meta">{fmtDate(post.data.pubDate)}</p>
        <p>{post.data.description}</p>
      </article>
    ))}
  </section>
</BaseLayout>
