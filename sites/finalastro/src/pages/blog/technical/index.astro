---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
const posts = (await getCollection("blog"))
  .filter((p) => p.data.section === "technical")
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function fmtDate(d) {
  const dd = String(d.getDate()).padStart(2, "0");
  const mm = String(d.getMonth() + 1).padStart(2, "0");
  return `${dd}-${mm}-${d.getFullYear()}`;
}
---

<BaseLayout
  title="Technical | Aritra"
  pageTitle="Technical"
  pageIntro="Notes and writeups on machine learning, systems, and research."
>
  <section class="panel">
    <div class="article-list">
      {posts.length > 0 ? posts.map((post) => (
        <article class="article-card">
          <h2><a href={`${base}/blog/technical/${post.id}/`}>{post.data.title}</a></h2>
          <p class="meta">{fmtDate(post.data.pubDate)}</p>
          <p>{post.data.description}</p>
        </article>
      )) : (
        <p class="muted">No posts yet.</p>
      )}
    </div>
  </section>
</BaseLayout>
