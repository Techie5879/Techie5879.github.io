---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../data/site.js";

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Experience">
  <section class="split exp-layout">
    <article class="panel">
      <h2>Work</h2>
      <div class="article-list">
        {site.work.map((item) => (
          <article class="timeline-item">
            {item.logo && (
              <div class="org-logo">
                <img
                  src={`${base}/logos/${item.logo}`}
                  alt={item.org}
                  class={item.logo.endsWith('.svg') && item.logo === 'tum.svg' ? 'logo-mono' : ''}
                />
              </div>
            )}
            <div class="timeline-content">
              <h3>{item.title}</h3>
              <p class="meta">{item.org} | {item.period}</p>
              <p>{item.summary}</p>
            </div>
          </article>
        ))}
      </div>
    </article>

    <article class="panel">
      <h2>Education</h2>
      <div class="article-list">
        {site.education.map((item) => (
          <article class="timeline-item">
            <div class="timeline-content">
              <h3>{item.title}</h3>
              <p class="meta">{item.org} | {item.period}</p>
              <p>{item.summary}</p>
            </div>
          </article>
        ))}
      </div>

      <h2 style="margin-top: 24px;">Selected Awards</h2>
      <div class="article-list">
        {site.awards.map((item) => (
          <article class="timeline-item">
            <div class="timeline-content">
              <h3>{item.title}</h3>
              <p class="meta">{item.meta}</p>
              <p>{item.summary}</p>
            </div>
          </article>
        ))}
      </div>
    </article>
  </section>
</BaseLayout>

<style>
  .exp-layout {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* Make work timeline items flex: logo left + content right */
  .timeline-item {
    display: flex !important;
    flex-direction: row;
    align-items: flex-start;
    gap: 0;
  }

  .org-logo {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    margin-right: 16px;
    margin-top: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    overflow: hidden;
    background: var(--bg-alt);
    border: 1px solid var(--border);
  }

  .org-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 5px;
    display: block !important; /* override global .article-card img { display: none } */
  }

  /* TUM logo uses currentColor — render it in dark */
  .org-logo img.logo-mono {
    filter: invert(0);
    color: var(--text-main);
  }

  .timeline-content {
    flex: 1;
    min-width: 0;
  }

  /* Items without logos still look clean */
  .timeline-item:not(:has(.org-logo)) .timeline-content {
    width: 100%;
  }
</style>
