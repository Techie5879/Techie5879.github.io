---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../data/site.js";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const withBase = (path) => `${base}${path}`;

const monthMap = {
  Jan: 0,
  Feb: 1,
  Mar: 2,
  Apr: 3,
  May: 4,
  Jun: 5,
  Jul: 6,
  Aug: 7,
  Sep: 8,
  Oct: 9,
  Nov: 10,
  Dec: 11
};

function parseMonthLabel(label) {
  if (label === "Present") {
    const now = new Date();
    return { year: now.getFullYear(), month: now.getMonth() };
  }

  const [monthText, yearText] = label.trim().split(" ");
  return { year: Number(yearText), month: monthMap[monthText] };
}

function formatDuration(period) {
  const [startText, endText] = period.split(/\s+[–-]\s+/);
  const start = parseMonthLabel(startText);
  const end = parseMonthLabel(endText);
  const totalMonths = (end.year - start.year) * 12 + (end.month - start.month) + 1;
  const years = Math.floor(totalMonths / 12);
  const months = totalMonths % 12;
  const parts = [];

  if (years) parts.push(`${years} yr${years === 1 ? "" : "s"}`);
  if (months) parts.push(`${months} mo${months === 1 ? "" : "s"}`);

  return parts.join(" ") || "0 mos";
}

function getWorkMeta(item) {
  return `${item.org} | ${item.period} | ${formatDuration(item.period)}`;
}

function getLogoClass(logo) {
  return [
    logo === "tum.svg" ? "logo-mono" : "",
    logo === "aiisc-wordmark.png" ? "logo-aiisc" : ""
  ]
    .filter(Boolean)
    .join(" ");
}
---

<BaseLayout title="Experience">
  <section class="split exp-layout">
    <article class="panel">
      <h2>Work</h2>
      <div class="article-list">
        {site.work.map((item) => (
          <article id={item.id} class="timeline-item">
            {item.logo && (
              <div class="org-logo">
                <img
                  src={withBase(`/logos/${item.logo}`)}
                  alt={item.org}
                  class={getLogoClass(item.logo)}
                />
              </div>
            )}
            <div class="timeline-content">
              <h3>{item.title}</h3>
              <p class="meta">{getWorkMeta(item)}</p>
              <p>{item.summary}</p>
            </div>
          </article>
        ))}
      </div>
    </article>

    <article class="panel">
      <h2>Education</h2>
      <div class="article-list">
        {site.education.map((item) => (
          <article class="timeline-item">
            <div class="timeline-content">
              <h3>{item.title}</h3>
              <p class="meta">{item.org}</p>
              <p>{item.summary}</p>
            </div>
          </article>
        ))}
      </div>

      <h2 style="margin-top: 24px;">Selected Awards</h2>
      <div class="article-list">
        {site.awards.map((item) => (
          <article class="timeline-item">
            <div class="timeline-content">
              <h3>{item.title}</h3>
              <p class="meta">{item.meta}</p>
              <p>{item.summary}</p>
            </div>
          </article>
        ))}
      </div>
    </article>
  </section>
</BaseLayout>

<style>
  .exp-layout {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* Make work timeline items flex: logo left + content right */
  .timeline-item {
    display: flex !important;
    flex-direction: row;
    align-items: flex-start;
    gap: 0;
    padding-top: 18px;
    padding-bottom: 20px;
  }

  .org-logo {
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    margin-right: 18px;
    margin-top: 1px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    overflow: hidden;
    background: var(--bg-alt);
    border: 1px solid var(--border);
  }

  .org-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 5px;
    display: block !important; /* override global .article-card img { display: none } */
  }

  /* TUM logo uses currentColor — render it in dark */
  .org-logo img.logo-mono {
    filter: invert(0);
    color: var(--text-main);
  }

  .org-logo img.logo-aiisc {
    padding: 1px;
  }

  .timeline-content {
    flex: 1;
    min-width: 0;
  }

  .timeline-content h3 {
    margin-bottom: 0;
    line-height: 1.08;
    font-size: 1.15rem; /* reduced from global 1.3rem */
  }

  .timeline-content .meta {
    font-size: 0.95rem; /* increased from 0.9rem */
    line-height: 1.15;
    margin-top: -2px;
    margin-bottom: 10px;
  }

  /* Tighter line spacing for description text */
  .timeline-content p:not(.meta) {
    line-height: 1.45;
  }

  /* Items without logos still look clean */
  .timeline-item:not(:has(.org-logo)) .timeline-content {
    width: 100%;
  }
</style>
