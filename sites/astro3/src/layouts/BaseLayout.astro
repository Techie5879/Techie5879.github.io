---
import "../styles/global.css";

const {
  title = "Aritra · The Swiss Grid",
  description = "Astro Swiss Grid preview for an academic portfolio.",
  pageTitle,
  pageIntro
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <div class="shell">
      <header class="site-header">
        <div class="brand">
          <strong>Aritra Bandyopadhyay</strong>
          <small>Swiss Grid // Astro</small>
        </div>
        <nav class="nav">
          <a href={`${base}/`}>Index</a>
          <a href={`${base}/publication/`}>Publications</a>
          <a href={`${base}/experience/`}>Experience</a>
          <a href={`${base}/blog/`}>Journal</a>
        </nav>
      </header>

      <main class="main-content">
        {pageTitle && (
          <div class="panel">
            <h2>{pageTitle}</h2>
            <div class="panel-content">
              {pageIntro && <p class="muted" style="font-size: 1.2rem;">{pageIntro}</p>}
              <slot />
            </div>
          </div>
        )}
        
        {!pageTitle && <slot />}
      </main>

      <footer class="site-footer">
        <div>&copy; {new Date().getFullYear()} Aritra Bandyopadhyay.</div>
        <div style="display: flex; gap: 16px;">
          <a href="/">Chooser</a>
          <a href="/media/resume.pdf">CV</a>
        </div>
      </footer>
    </div>
  </body>
</html>