---
import "../styles/global.css";

const {
  title = "Aritra · Astro",
  description = "Astro preview for an academic portfolio comparison.",
  pageTitle,
  pageIntro
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Instrument+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main class="shell">
      <header class="site-header">
        <div class="brand">
          <strong>Astro Preview</strong>
          <small>Content collections + editorial portfolio layout</small>
        </div>
        <nav class="nav">
          <a href={base}>Home</a>
          <a href={`${base}publication/`}>Publications</a>
          <a href={`${base}experience/`}>Experience</a>
          <a href={`${base}blog/`}>Blog</a>
        </nav>
      </header>

      {pageTitle && (
        <section class="panel">
          <h1 class="page-title">{pageTitle}</h1>
          {pageIntro && <p class="muted">{pageIntro}</p>}
        </section>
      )}

      <slot />

      <footer class="site-footer">
        <div>
          <strong>Aritra Bandyopadhyay</strong>
          <div class="meta">Astro route preview for `techie5879.github.io`.</div>
        </div>
        <div class="nav">
          <a href="/">Chooser</a>
          <a href="/media/resume.pdf">Resume</a>
        </div>
      </footer>
    </main>
  </body>
</html>
