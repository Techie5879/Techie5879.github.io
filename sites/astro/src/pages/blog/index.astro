---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="Technical Blog · Astro"
  pageTitle="Technical Blog"
  pageIntro="An Astro blog listing built from content collections."
>
  <section class="article-list">
    {posts.map((post) => (
      <article class="article-card">
        {post.data.image && <img src={post.data.image} alt={post.data.title} />}
        <h2>{post.data.title}</h2>
        <p class="meta">{post.data.pubDate.toISOString().slice(0, 10)}</p>
        <p>{post.data.description}</p>
        <div class="route-row">
          {post.data.categories.map((category) => <span class="pill">{category}</span>)}
        </div>
        <p><a class="button primary" href={`${base}/blog/${post.id}/`}>Read post</a></p>
      </article>
    ))}
  </section>
</BaseLayout>
