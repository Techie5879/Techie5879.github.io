---
import "../styles/global.css";

const {
  title = "Aritra · Neo-Brutalist",
  description = "Astro brutalist preview for an academic portfolio.",
  pageTitle,
  pageIntro
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main class="shell">
      <header class="site-header">
        <div class="brand">
          <strong>Astro-Brutal</strong>
          <small>Raw Academic Portfolio</small>
        </div>
        <nav class="nav">
          <a href={`${base}/`}>Home</a>
          <a href={`${base}/publication/`}>Pubs</a>
          <a href={`${base}/experience/`}>Exp</a>
          <a href={`${base}/blog/`}>Blog</a>
        </nav>
      </header>

      {pageTitle && (
        <section class="panel">
          <h1 class="page-title">{pageTitle}</h1>
          {pageIntro && <p class="muted" style="background: var(--bg-panel); padding: 16px; border: var(--border-width) solid var(--border); box-shadow: 4px 4px 0px var(--border); max-width: 600px; font-weight: 600;">{pageIntro}</p>}
        </section>
      )}

      <slot />

      <footer class="site-footer">
        <div>
          <strong>Aritra Bandyopadhyay</strong>
          <div class="meta">Neo-Brutalist Astro Preview.</div>
        </div>
        <div class="nav">
          <a href="/">Chooser</a>
          <a href="/media/resume.pdf">Resume</a>
        </div>
      </footer>
    </main>
  </body>
</html>