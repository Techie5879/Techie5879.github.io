---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site.js";

const base = import.meta.env.BASE_URL;
const [featuredPublication] = await getCollection("publications");
const [featuredPost] = await getCollection("blog");
---

<BaseLayout title="Aritra · Astro Terminal" description={site.about}>
  <section class="hero">
    <div>
      <p class="muted">{`{ "status": "online", "role": "${site.role}" }`}</p>
      <h1>{site.name}</h1>
      <p>{site.institution}</p>
      <p>{site.about}</p>
      
      <div class="hero-actions">
        <a class="button primary" href={`${base}/blog/`}>./read_notes.sh</a>
        <a class="button" href={`${base}/publication/`}>ls -la publications/</a>
        <a class="button" href="/media/resume.pdf">wget resume.pdf</a>
      </div>
      
      <div class="socials">
        {site.socials.map((item) => (
          <a class="pill" href={item.href}>{item.label}</a>
        ))}
      </div>
    </div>
  </section>

  <section class="panel">
    <h2>grep -r "Research" .</h2>
    <div class="article-card">
      <p>{site.research}</p>
      <div style="margin-top: 16px; display: flex; gap: 8px; flex-wrap: wrap;">
        <span class="pill">#routing</span>
        <span class="pill">#collections</span>
        <span class="pill">#static</span>
      </div>
    </div>
  </section>

  <section class="panel">
    <h2>head -n 1 publications.txt</h2>
    <div class="article-card">
      <h3>{featuredPublication.data.title}</h3>
      <p class="meta">{featuredPublication.data.venue} | {featuredPublication.data.pubDate.getFullYear()}</p>
      <p>{featuredPublication.data.description}</p>
      <p style="margin-top: 16px;"><a class="button" href={`${base}/publication/${featuredPublication.id}/`}>open {featuredPublication.id}.pdf</a></p>
    </div>
  </section>

  <section class="panel">
    <h2>ls -l projects/</h2>
    <div class="grid">
      {site.projects.map((project) => (
        <article class="project-card">
          <h3>{project.title}</h3>
          <p>{project.summary}</p>
          <p style="margin-top: 16px;"><a class="button" href={project.href}>git clone {project.title.toLowerCase().replace(/\s+/g, '-')}</a></p>
        </article>
      ))}
    </div>
  </section>

  <section class="panel">
    <h2>tail -n 1 logs.txt</h2>
    <article class="article-card">
      <h3>{featuredPost.data.title}</h3>
      <p class="meta">[{featuredPost.data.pubDate.toISOString().slice(0, 10)}]</p>
      <p>{featuredPost.data.description}</p>
      <p style="margin-top: 16px;"><a class="button" href={`${base}/blog/${featuredPost.id}/`}>cat {featuredPost.id}.md</a></p>
    </article>
  </section>
</BaseLayout>