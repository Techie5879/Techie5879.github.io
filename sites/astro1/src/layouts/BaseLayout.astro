---
import "../styles/global.css";

const {
  title = "Aritra · Astro Terminal",
  description = "Astro terminal preview for an academic portfolio.",
  pageTitle,
  pageIntro
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main class="shell">
      <header class="site-header">
        <div class="brand">
          <strong>Astro_Preview.sh</strong>
          <small>v1.0.4 | Terminal Academic Theme</small>
        </div>
        <nav class="nav">
          <a href={`${base}/`}>~/home</a>
          <a href={`${base}/publication/`}>~/publications</a>
          <a href={`${base}/experience/`}>~/experience</a>
          <a href={`${base}/blog/`}>~/blog</a>
        </nav>
      </header>

      {pageTitle && (
        <section class="panel">
          <h1 class="page-title">{pageTitle}</h1>
          {pageIntro && <p class="muted">// {pageIntro}</p>}
        </section>
      )}

      <slot />

      <footer class="site-footer">
        <div>
          <strong>[ EOF ]</strong>
          <div class="meta">Execution finished. Aritra Bandyopadhyay.</div>
        </div>
        <div class="nav">
          <a href="/">cd ../chooser</a>
          <a href="/media/resume.pdf">cat resume.pdf</a>
        </div>
      </footer>
    </main>
  </body>
</html>