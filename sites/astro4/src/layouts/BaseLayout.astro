---
import "../styles/global.css";

const {
  title = "Aritra · The Monograph",
  description = "Astro Monograph preview for an academic portfolio.",
  pageTitle,
  pageIntro
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <main class="shell">
      <header class="site-header">
        <div class="brand">
          <strong>Aritra Bandyopadhyay</strong>
          <small>Volume IV · The Monograph</small>
        </div>
        <nav class="nav">
          <a href={`${base}/`}>Preface</a>
          <a href={`${base}/publication/`}>Bibliography</a>
          <a href={`${base}/experience/`}>Chronicle</a>
          <a href={`${base}/blog/`}>Appendices</a>
        </nav>
      </header>

      {pageTitle && (
        <section class="panel">
          <h2>{pageTitle}</h2>
          {pageIntro && <p style="text-align: center; color: var(--text-muted); font-style: italic;">{pageIntro}</p>}
        </section>
      )}

      <slot />

      <footer class="site-footer">
        <div style="margin-bottom: 16px;">FINIS.</div>
        <a href="/">Index</a>
        <a href="/media/resume.pdf">Curriculum Vitae</a>
      </footer>
    </main>
  </body>
</html>