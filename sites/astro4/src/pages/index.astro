---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site.js";

const base = import.meta.env.BASE_URL;
const [featuredPublication] = await getCollection("publications");
const [featuredPost] = await getCollection("blog");
---

<BaseLayout title="Aritra · The Monograph" description={site.about}>
  <section class="hero">
    <img src="/media/avatar.jpg" alt="Aritra" />
    <span class="muted">{site.role} at {site.institution}</span>
    <p>{site.about}</p>
    
    <div class="socials">
      {site.socials.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </div>
  </section>

  <section class="panel">
    <h2>Focus</h2>
    <p style="text-align: center;">{site.research}</p>
  </section>

  <section class="panel">
    <h2>Select Treatise</h2>
    <div class="article-card">
      <h3>{featuredPublication.data.title}</h3>
      <span class="meta">{featuredPublication.data.venue} — {featuredPublication.data.pubDate.getFullYear()}</span>
      <p>{featuredPublication.data.description}</p>
      <a class="button" href={`${base}/publication/${featuredPublication.id}/`}>Read Treatise</a>
    </div>
  </section>

  <section class="panel">
    <h2>Software Constructs</h2>
    <div class="grid">
      {site.projects.map((project) => (
        <div class="article-card">
          <h3>{project.title}</h3>
          <p>{project.summary}</p>
          <a class="button" href={project.href}>Examine Code</a>
        </div>
      ))}
    </div>
  </section>

  <section class="panel">
    <h2>Recent Appendix</h2>
    <div class="article-card">
      <h3>{featuredPost.data.title}</h3>
      <span class="meta">{featuredPost.data.pubDate.toISOString().slice(0, 10)}</span>
      <p>{featuredPost.data.description}</p>
      <a class="button" href={`${base}/blog/${featuredPost.id}/`}>Read Entry</a>
    </div>
  </section>
</BaseLayout>